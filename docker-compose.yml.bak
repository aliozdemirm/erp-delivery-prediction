# ============================================================
# ERP Delivery Prediction — Docker Compose Service Skeleton
# T-104: Configure Docker Compose Service Skeleton
#
# Communication topology:
#   frontend  → api
#   api       → postgres
#   api       → mock-erp
#   api       → ai-prediction
#
# Publicly exposed ports (dev only):
#   frontend  → ${FRONTEND_PORT:-3000}
#   api       → ${API_PORT:-5000}  (Swagger / dev access)
#
# Not publicly exposed:
#   postgres, mock-erp, ai-prediction
# ============================================================

services:

  # ----------------------------------------------------------
  # frontend — React + Vite + TypeScript SPA
  # Served by Nginx inside the container.
  # Only service with a user-facing published port.
  # ----------------------------------------------------------
  frontend:
    build:
      context: ./frontend
      dockerfile: Dockerfile
      args:
        # VITE_* variables are build-time values: Vite inlines them
        # statically into the bundle during `npm run build`.
        # They MUST be passed as Docker build ARGs, NOT runtime env vars.
        # See frontend/Dockerfile for the ARG → ENV → RUN npm run build chain.
        - VITE_API_BASE_URL=${VITE_API_BASE_URL:-http://localhost:5000}
    ports:
      - "${FRONTEND_PORT:-3000}:80"
    networks:
      - erp-net
    depends_on:
      - api
    restart: unless-stopped

  # ----------------------------------------------------------
  # api — ASP.NET Core Web API (App.Api)
  # Composition root; connects to postgres, mock-erp,
  # and ai-prediction exclusively over the internal network.
  # API/Swagger port is published for development only.
  # ----------------------------------------------------------
  api:
    build:
      context: .
      dockerfile: src/App.Api/Dockerfile
    ports:
      - "${API_PORT:-5000}:8080"
    environment:
      - ASPNETCORE_ENVIRONMENT=${ASPNETCORE_ENVIRONMENT:-Development}
      - ASPNETCORE_URLS=http://+:8080
      - ConnectionStrings__DefaultConnection=${CONNECTION_STRING:-Host=postgres;Port=5432;Database=erp_delivery;Username=erp_user;Password=change_me_postgres_password}
      - Jwt__Secret=${JWT_SECRET:-change_me_jwt_secret_at_least_32_characters_long}
      - Jwt__Issuer=${JWT_ISSUER:-erp-delivery-prediction}
      - Jwt__Audience=${JWT_AUDIENCE:-erp-delivery-prediction-clients}
      - MockErp__BaseUrl=${MOCK_ERP_BASE_URL:-http://mock-erp:8080}
      - AiPrediction__BaseUrl=${AI_PREDICTION_BASE_URL:-http://ai-prediction:8000}
      - AiPrediction__TimeoutMs=${AI_PREDICTION_TIMEOUT_MS:-3000}
      - Cors__AllowedOrigin=${CORS_ALLOWED_ORIGIN:-http://localhost:3000}
    networks:
      - erp-net
    depends_on:
      postgres:
        condition: service_healthy
      mock-erp:
        condition: service_started
      ai-prediction:
        condition: service_started
    # TODO (T-103): replace placeholder command once App.Api Dockerfile
    #               produces a runnable image.
    restart: unless-stopped

  # ----------------------------------------------------------
  # postgres — Application database (PostgreSQL 18)
  # NOT publicly exposed.
  # Health check ensures dependents wait until DB is ready.
  # ----------------------------------------------------------
  postgres:
    image: postgres:18-alpine
    environment:
      - POSTGRES_DB=${POSTGRES_DB:-erp_delivery}
      - POSTGRES_USER=${POSTGRES_USER:-erp_user}
      - POSTGRES_PASSWORD=${POSTGRES_PASSWORD:-change_me_postgres_password}
    volumes:
      - postgres-data:/var/lib/postgresql
    networks:
      - erp-net
    ports:
      - "5432:5432"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER:-erp_user} -d ${POSTGRES_DB:-erp_delivery}"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 10s
    restart: unless-stopped

  # ----------------------------------------------------------
  # mock-erp — Read-only Mock ERP API (MockErp.Api)
  # NOT publicly exposed.
  # Serves static JSON seed data consumed only by api.
  # ----------------------------------------------------------
  mock-erp:
    build:
      context: .
      dockerfile: src/MockErp.Api/Dockerfile
    environment:
      - ASPNETCORE_ENVIRONMENT=${ASPNETCORE_ENVIRONMENT:-Development}
      - ASPNETCORE_URLS=http://+:8080
    networks:
      - erp-net
    # No "ports:" block → not reachable from the host
    # TODO (T-103): replace placeholder command once MockErp.Api Dockerfile
    #               produces a runnable image.
    restart: unless-stopped

  # ----------------------------------------------------------
  # ai-prediction — Python + FastAPI AI Prediction Service
  # NOT publicly exposed.
  # Exposes /health endpoint on internal port 8000.
  # /predict endpoint will be added once T-105 is completed.
  # ----------------------------------------------------------
  ai-prediction:
    build:
      context: ./ai-prediction
      dockerfile: Dockerfile
    environment:
      - PORT=${AI_PORT:-8000}
      - MODEL_PATH=${AI_MODEL_PATH:-/app/models/model.pkl}
      - FEATURE_SCHEMA_VERSION=${AI_FEATURE_SCHEMA_VERSION:-1}
      - MODEL_VERSION=${AI_MODEL_VERSION:-1}
      - TRAINING_DATASET_VERSION=${AI_TRAINING_DATASET_VERSION:-1}
    networks:
      - erp-net
    # No "ports:" block → not reachable from the host
    # TODO (T-105): replace placeholder command once ai-prediction
    #               Dockerfile and model artifact are finalized.
    restart: unless-stopped

# ============================================================
# Networks
# ============================================================
networks:
  erp-net:
    driver: bridge
    internal: true

# ============================================================
# Volumes
# ============================================================
volumes:
  postgres-data:
